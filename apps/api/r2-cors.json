{
  "rules": [
    {
      "allowed": {
        "origins": [
          "*"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "*"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Type"
      ],
      "maxAgeSeconds": 86400
    },
    {
      "allowed": {
        "origins": [
          "https://rivvon.ca",
          "https://slyce.rivvon.ca",
          "http://localhost:5173",
          "http://localhost:5174",
          "http://localhost:5175",
          "http://localhost:5176",
          "http://localhost:5177"
        ],
        "methods": [
          "PUT"
        ],
        "headers": [
          "Content-Type",
          "Cache-Control"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
